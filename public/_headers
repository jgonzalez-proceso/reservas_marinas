# Cabeceras del sitio publicado. Cloudflare Pages y Netlify lo leen desde la
# raiz; Vite lo copia aqui tal cual desde public/. Vercel NO lo lee: alli las
# mismas reglas van en vercel.json (ver docs/publicacion.md).
#
# Las reglas que casan se acumulan, no se sustituyen, asi que /assets/* pone la
# cache tambien a los GeoJSON y /assets/capas/* solo anade el tipo.

# Todo lo que hay en assets/ lleva hash de contenido en el nombre: si los datos
# cambian, cambia el nombre. Lo ya descargado nunca queda obsoleto, asi que
# puede cachearse para siempre. Es lo que convierte los 6,6 MB en una descarga
# unica y no en el peaje de cada consulta -- que es justo lo que importa cuando
# alguien abre esto desde una barca con cobertura de movil.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Los GeoJSON se sirven como application/json, no como application/geo+json.
# La compresion de las CDN se decide por una lista de tipos y geo+json no esta
# en ninguna: sin esto la cartografia viaja sin comprimir, que son 31 MB en vez
# de 6,6. Comprobar en el primer despliegue, no darlo por hecho:
#   curl -sI -H 'Accept-Encoding: gzip' <url>/assets/capas/<fichero>.geojson
# tiene que contestar content-encoding: gzip (o br).
/assets/capas/*
  Content-Type: application/json; charset=utf-8

# El HTML no se cachea: es quien reparte los nombres con hash nuevos. Si se
# cachea el, un despliegue nuevo no llega hasta que caduque.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
