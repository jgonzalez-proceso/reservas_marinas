{
  // Cloudflare ha unificado Pages y Workers bajo el mismo flujo de "Workers
  // static assets": el asistente de "Connect to Git" que ves hoy crea un
  // Worker, no un proyecto Pages clásico, aunque el sitio sea puramente
  // estático y no haya ningún script. Sin este fichero ese asistente no
  // tiene qué desplegar.
  //
  // https://developers.cloudflare.com/workers/static-assets/
  "name": "reservas-marinas",
  "compatibility_date": "2026-08-17",
  "assets": {
    // dist/ es la salida de `npm run build`. No hay Worker script: todo lo
    // que sirve esta web son ficheros estáticos, así que el binding y el
    // entry point (`main`) se omiten a propósito.
    "directory": "./dist",
    // Aquí ponía "single-page-application", y contradecía al resto del
    // proyecto. Ese modo sirve index.html con estado 200 para cualquier ruta
    // inexistente, que es EXACTAMENTE el comportamiento que `public/404.html`
    // existe para corregir: está documentado en docs/publicacion.md que en
    // producción `/pagina-que-no-existe`, `/robots.txt` y `/sitemap.xml`
    // devolvían los tres la portada con un 200, convirtiendo cada URL
    // inventada en una copia indexable de la portada y rompiendo el parseo
    // del sitemap. Se arregló una vez; este fichero lo habría reintroducido
    // el día que alguien desplegara por aquí.
    //
    // La web no tiene rutas propias —la vista por isla va en el hash, que el
    // servidor no ve—, así que no hay ninguna SPA que enrutar. Lo que hace
    // falta es que `dist/404.html` se sirva con un 404 de verdad.
    //
    // Si algún día se usa este camino, verifica el valor contra la
    // documentación de Cloudflare antes de fiarte: es semántica de la
    // plataforma, no del repositorio, y cambia con el tiempo.
    "not_found_handling": "404-page"
  }
}
